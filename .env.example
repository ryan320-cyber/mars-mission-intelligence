# Mars Mission Intelligence Environment Configuration
# Copy this file to .env and adjust variables as required.

# Server Configuration
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development

# NASA Data Access (DEMO_KEY works for standard open endpoints)
NASA_API_KEY=DEMO_KEY

# Security & CORS (comma-separated origins)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Optional LLM API Key (for external LLM provider extensions)
# LLM_API_KEY=your-api-key-here
